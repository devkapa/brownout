{
  "compilerOptions": {
    "target": "ES2022",
    // No "dom" lib on purpose: the engine must typecheck with zero browser
    // globals. Node globals (performance, setTimeout, atob) come from
    // @types/node, which the >=20 engines floor already implies.
    "lib": ["ES2022"],
    "types": ["node"],
    // NodeNext everywhere: the published dist is plain tsc output that Node
    // itself must resolve, so the compiler has to enforce runnable specifiers
    // (explicit .js extensions, JSON import attributes) at typecheck time
    // instead of leaving them to be discovered at import time.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["src", "test", "scripts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
