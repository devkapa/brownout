{
  "compilerOptions": {
    "target": "ES2022",
    // No "dom" lib on purpose: the engine must typecheck with zero browser
    // globals. Node globals (performance, setTimeout, atob) come from
    // @types/node, which the >=20.18.3 engines floor already implies.
    "lib": ["ES2022"],
    "types": ["node"],
    // NodeNext everywhere: the published dist is plain tsc output that Node
    // itself must resolve, so the compiler has to enforce runnable specifiers
    // (explicit .js extensions, JSON import attributes) at typecheck time
    // instead of leaving them to be discovered at import time.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["src", "test", "scripts", "vitest.config.ts", "vitest.core-suites.config.ts"],
  // test/types/** are standalone fixtures with their own tsconfig.json (a
  // deliberately DIFFERENT lib set — see test/types/dom-consumer), checked
  // via their own `pnpm run typecheck:*` script, the same way `examples/`
  // (not in `include` above at all) is checked via `typecheck:examples`
  // rather than this project's own `tsc --noEmit`.
  "exclude": ["node_modules", "dist", "test/types"]
}
