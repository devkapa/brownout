{
  "name": "brownout",
  "version": "0.1.0",
  "description": "Mixed-signal circuit simulation engine: sparse MNA solver, SPICE netlist subset, small-signal AC, and cycle-accurate AVR/RP2040 co-simulation",
  "license": "MIT",
  "type": "module",
  "repository": "github:devkapa/brownout",
  "homepage": "https://github.com/devkapa/brownout#readme",
  "keywords": [
    "circuit-simulation",
    "circuit-simulator",
    "simulation",
    "spice",
    "netlist",
    "ngspice",
    "mna",
    "nodal-analysis",
    "transient-analysis",
    "electronics",
    "mixed-signal",
    "analog",
    "eda",
    "arduino",
    "avr",
    "avr8js",
    "rp2040",
    "rp2040js",
    "raspberry-pi-pico",
    "microcontroller",
    "emulator"
  ],
  "engines": {
    "node": ">=20.18.3"
  },
  "packageManager": "pnpm@10.33.0",
  "files": [
    "dist",
    "docs",
    "!docs/releasing.md",
    "!docs/packaging-verification.md",
    "LICENSE",
    "README.md",
    "NOTICE"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./spice": {
      "types": "./dist/spice.d.ts",
      "import": "./dist/spice.js"
    },
    "./ac": {
      "types": "./dist/ac.d.ts",
      "import": "./dist/ac.js"
    },
    "./analysis": {
      "types": "./dist/analysis.d.ts",
      "import": "./dist/analysis.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./physics": {
      "types": "./dist/physics.d.ts",
      "import": "./dist/physics.js"
    },
    "./mcu": {
      "types": "./dist/mcu.d.ts",
      "import": "./dist/mcu.js"
    },
    "./mcu/rp2040": {
      "types": "./dist/mcu/rp2040.d.ts",
      "import": "./dist/mcu/rp2040.js"
    },
    "./internals/*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist .tsbuildinfo && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:sparse": "SIMCORE_LINEAR_BACKEND=sparse vitest run",
    "bench": "tsx scripts/benchmark-linear-scale.ts",
    "check:package": "publint && attw --pack . --profile esm-only",
    "release": "changeset publish",
    "example:rc": "tsx examples/rc-transient.ts",
    "example:bode": "tsx examples/spice-bode.ts",
    "example:device": "tsx examples/custom-device.ts",
    "typecheck:examples": "tsc -p examples/tsconfig.json",
    "examples": "pnpm run build && pnpm run typecheck:examples && pnpm run example:rc && pnpm run example:bode && pnpm run example:device"
  },
  "peerDependencies": {
    "avr8js": "^0.21.0",
    "rp2040js": "^1.3.3"
  },
  "peerDependenciesMeta": {
    "avr8js": {
      "optional": true
    },
    "rp2040js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.19.17",
    "avr8js": "^0.21.0",
    "esbuild": "^0.27.7",
    "publint": "^0.2.12",
    "rp2040js": "^1.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
